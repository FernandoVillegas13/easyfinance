# Copy to .env and source it from the repository root after AWS SSO login:
#   cp infra/terraform/.env.example infra/terraform/.env
#   aws sso login --profile easyfinance-dev
#   source infra/terraform/.env

export AWS_PROFILE="${AWS_PROFILE:-easyfinance-dev}"
export AWS_REGION="${AWS_REGION:-us-east-1}"
export AWS_DEFAULT_REGION="${AWS_REGION}"
export AWS_SDK_LOAD_CONFIG=1

export TF_VAR_environment="${TF_VAR_environment:-dev}"
export TF_VAR_aws_region="${AWS_REGION}"
export TF_VAR_infra_version="${TF_VAR_infra_version:-v1}"
export TF_VAR_log_retention_days="${TF_VAR_log_retention_days:-30}"
export TF_VAR_s3_session_bucket_name="${TF_VAR_s3_session_bucket_name:-easyfinance}"

export TF_VAR_db_host="${TF_VAR_db_host}"
export TF_VAR_db_port="${TF_VAR_db_port:-5432}"
export TF_VAR_db_name="${TF_VAR_db_name}"
export TF_VAR_db_user="${TF_VAR_db_user}"
export TF_VAR_db_password="${TF_VAR_db_password}"
export TF_VAR_db_schema="${TF_VAR_db_schema}"
export TF_VAR_api_key="${TF_VAR_api_key}"

if ! TF_VAR_aws_account_id="$(aws sts get-caller-identity --query Account --output text)"; then
  echo "Unable to resolve the AWS account. Run: aws sso login --profile ${AWS_PROFILE}" >&2
  return 1 2>/dev/null || exit 1
fi
export TF_VAR_aws_account_id

export TF_BACKEND_BUCKET="terraform-state-${TF_VAR_aws_account_id}"
export TF_BACKEND_KEY="easyfinance/${TF_VAR_environment}/terraform.tfstate"
export TF_BACKEND_REGION="${AWS_REGION}"
