.venv/
.venv-*/
venv/
env/
ENV/
.virtualenv/

# Environment variables and local secrets
.env
.env.*
!.env.example
!.env.sample

# Packaging and build artifacts
build/
dist/
.eggs/
*.egg-info/
*.egg
pip-wheel-metadata/

