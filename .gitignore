# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
.venv-*/
venv/
env/
ENV/
.virtualenv/

# Environment variables and local secrets
.env
.env.*
!.env.example
!.env.sample

# Packaging and build artifacts
build/
dist/
.eggs/
*.egg-info/
*.egg
pip-wheel-metadata/

# Test, coverage, lint, and type-checker caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.hypothesis/

# Runtime and local development files
*.log
*.pid
*.sqlite3
*.db

# Jupyter
.ipynb_checkpoints/

# IDE and operating system files
.DS_Store
.vscode/
.idea/

# Swift / Xcode
swift/*.xcodeproj/xcuserdata/
swift/*.xcodeproj/project.xcworkspace/xcuserdata/
swift/*.xcodeproj/project.xcworkspace/xcshareddata/
swift/**/*.xcuserstate
swift/**/.DS_Store
swift/DerivedData/
swift/**/*.hmap
swift/**/*.ipa
swift/**/*.dSYM.zip
swift/**/*.dSYM
swift/**/build/

# Terraform local state and sensitive inputs
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local watch app credentials
swift/Configuration/Secrets.xcconfig
